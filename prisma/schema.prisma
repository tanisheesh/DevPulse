generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js adapter tables ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  githubLogin   String?
  accessToken   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  repositories    Repository[]
  commits         CommitRecord[]
  pullRequests    PullRequestRecord[]
  issues          IssueRecord[]
  burnoutSnapshots BurnoutSnapshot[]
  standupReports  StandupReport[]
  weeklySummaries WeeklySummary[]
  monthlyReviews  MonthlyReview[]
  settings        UserSettings?
  blackoutDates   BlackoutDate[]
  goals           Goal[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── DevPulse domain tables ────────────────────────────────────────────────

model Repository {
  id              String    @id @default(cuid())
  userId          String
  owner           String
  name            String
  fullName        String
  isPrivate       Boolean   @default(false)
  selectedForSync Boolean   @default(false)
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  commits      CommitRecord[]
  pullRequests PullRequestRecord[]
  issues       IssueRecord[]

  @@unique([userId, fullName])
  @@index([userId])
}

model CommitRecord {
  id         String   @id @default(cuid())
  userId     String
  repoId     String
  sha        String
  message    String
  authoredAt DateTime
  additions  Int      @default(0)
  deletions  Int      @default(0)
  url        String?

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, sha])
  @@index([userId, authoredAt])
}

model PullRequestRecord {
  id        String    @id @default(cuid())
  userId    String
  repoId    String
  number    Int
  title     String
  state     String
  createdAt DateTime
  mergedAt  DateTime?
  url       String?

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, number])
  @@index([userId, createdAt])
}

model IssueRecord {
  id        String    @id @default(cuid())
  userId    String
  repoId    String
  number    Int
  title     String
  state     String
  createdAt DateTime
  closedAt  DateTime?
  url       String?

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, number])
  @@index([userId, createdAt])
}

model BurnoutSnapshot {
  id                   String   @id @default(cuid())
  userId               String
  date                 DateTime @db.Date
  score                Int
  lateNightCommitCount Int
  weekendCommitCount   Int
  totalCommitCount     Int
  explanation          String?
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model StandupReport {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  content     String   @db.Text
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model WeeklySummary {
  id          String   @id @default(cuid())
  userId      String
  weekStart   DateTime @db.Date
  content     String   @db.Text
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model MonthlyReview {
  id          String   @id @default(cuid())
  userId      String
  monthStart  DateTime @db.Date
  content     String   @db.Text
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthStart])
  @@index([userId])
}

model UserSettings {
  id            String @id @default(cuid())
  userId        String @unique
  timezone      String @default("UTC")
  workStartHour Int    @default(9)
  workEndHour   Int    @default(23)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlackoutDate {
  id        String   @id @default(cuid())
  userId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  label     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime @db.Date
  type      String   // "commits" | "prs" | "issues"
  target    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart, type])
  @@index([userId, weekStart])
}

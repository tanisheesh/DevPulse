# ─── Database (Neon Postgres) ───────────────────────────────────────────────
# Get from https://console.neon.tech → your project → Connection Details → Pooled connection
DATABASE_URL="postgresql://user:password@host/devpulse?sslmode=verify-full"

# ─── Auth.js ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace_with_random_secret"
# Your deployment URL (http://localhost:3000 for local dev)
NEXTAUTH_URL="http://localhost:3000"

# ─── GitHub OAuth App ───────────────────────────────────────────────────────
# Create at https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID="your_github_oauth_client_id"
GITHUB_SECRET="your_github_oauth_client_secret"

# ─── Groq API ───────────────────────────────────────────────────────────────
# Get from https://console.groq.com/keys  (ROTATE your old key first!)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# ─── Encryption key for stored GitHub access tokens ─────────────────────────
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace_with_32_byte_base64_key"
